# Agent/session settings — locali per macchina, non per il repo.
.claude/
.codex/

# Output generato: il grafo di navigazione si rigenera, non si versiona.
graphify-out/

# Logs / backup lasciati dagli strumenti (clients.py salva un .bak a ogni
# modifica dei config dei client MCP).
*.log
*.bak

# Launchers are install.cmd / install.sh / install.command — no compiled
# binary is ever shipped in-tree (a stale NeuronInstaller.exe used to be).
*.exe
